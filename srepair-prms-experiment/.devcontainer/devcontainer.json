{
  "name": "SRepair PRMS Experiment",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "redhat.java"
      ],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash",
        "terminal.integrated.profiles.linux": {
          "bash": { "path": "/bin/bash" }
        }
      }
    }
  },
  "remoteUser": "vscode",
  "workspaceFolder": "/workspaces/srepair-prms-experiment",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspaces/srepair-prms-experiment,type=bind"
}